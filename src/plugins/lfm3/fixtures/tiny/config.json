{
 "model_type": "lfm3",
 "architectures": [
  "Lfm3ForCausalLM"
 ],
 "vocab_size": 128,
 "hidden_size": 32,
 "intermediate_size": 48,
 "num_hidden_layers": 5,
 "num_attention_heads": 2,
 "num_key_value_heads": 1,
 "head_dim": 16,
 "norm_eps": 1e-05,
 "conv_L_cache": 7,
 "conv_bias": false,
 "layer_types": [
  "conv",
  "full_attention",
  "sliding_attention",
  "conv",
  "full_attention"
 ],
 "rope_parameters": {
  "full_attention": {
   "rope_theta": 10.0,
   "partial_rotary_factor": 0.5,
   "rope_type": "default"
  },
  "sliding_attention": {
   "rope_theta": 100.0,
   "rope_type": "default"
  }
 },
 "sliding_window": 4,
 "use_sandwich_norm": true,
 "tie_word_embeddings": true,
 "max_position_embeddings": 4096,
 "bos_token_id": 1,
 "eos_token_id": 2,
 "dtype": "float32"
}