    "This agent can't answer until %@ is on disk. Nothing is downloaded automatically.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %1$@ 下载到本地之前，这个智能体无法回答。系统不会自动下载任何内容。"
          }
        }
      }
    },
    "This can't be undone.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作无法撤销。"
          }
