      }
    },
    "The tool-calling loop: shell, files, search, tasks, media generation.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具调用循环：shell、文件、搜索、任务、媒体生成。"
          }
        }
      }
    },
