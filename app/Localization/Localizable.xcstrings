    "Add the tools from every enabled Model Context Protocol server.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入所有已启用的 Model Context Protocol 服务器提供的工具。"
          }
        }
      }
    },
    "Additive penalty per token already present in the context. 0 = none.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对已出现在上下文中的每个 token 施加的加性惩罚。0 表示不惩罚。"
          }
        }
      }
    },
    "Adds your enabled MCP servers' tools. Click to turn it %@; right-click for the Marketplace.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入已启用的 MCP 服务器提供的工具。点按可%1$@；右键打开市场。"
          }
        }
      }
    },
    "Advanced": {
      "extractionState": "manual",
