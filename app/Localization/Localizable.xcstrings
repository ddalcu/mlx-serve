    "No drafter for the MoE Gemma 4 — it regresses decode there. Use PLD instead.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MoE 版 Gemma 4 不使用草稿模型 — 它在该模型上会拖慢解码。请改用 PLD。"
          }
        }
      }
    },
    "No generation yet": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有生成结果"
          }
        }
      }
    },
    "No local models yet — download one first.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有本地模型 —— 请先下载一个。"
          }
