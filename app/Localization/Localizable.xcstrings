    "Message your local model from your phone via a Telegram bot. No public URL or port-forwarding needed — the app long-polls Telegram over your normal internet connection, so it works behind home Wi-Fi.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 Telegram 机器人用手机与本地模型对话。无需公网地址或端口转发 — 应用通过普通网络连接对 Telegram 长轮询，因此在家庭 Wi-Fi 后也能使用。"
          }
        }
      }
    },
    "Messaging — Telegram bot": {
      "extractionState": "manual",
