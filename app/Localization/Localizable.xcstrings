        }
      }
    },
    "Paste the token @BotFather gives you after /newbot. Stored locally on this Mac and sent only to Telegram's API.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴 @BotFather 在 /newbot 之后给你的令牌。它只保存在本机，并且仅发送给 Telegram 的 API。"
          }
        }
      }
    },
    "Path to a Gemma 4 assistant drafter directory (gemma-4-*-it-assistant-bf16). Must pair with a Gemma 4 target. Empty = no drafter.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemma 4 助理草稿模型目录的路径（gemma-4-*-it-assistant-bf16）。必须与对应的 Gemma 4 主模型配套。留空表示不使用草稿模型。"
          }
        }
      }
    },
    "Pause": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停"
          }
        }
      }
    },
    "Penalty multiplier for tokens already in the context. 1.0 = none. 1.1 is a typical anti-repeat setting.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对已出现在上下文中的 token 施加的惩罚系数。1.0 表示不惩罚。1.1 是常见的防重复取值。"
          }
        }
      }
    },
    "Per-LoadedModel LRU of chat-template render+tokenize results. Skips re-rendering identical message lists on warm reuse — drops warm tokenize_ms from ~240 ms to ~0 on long-prompt repeats. Applies to all engines. 0 disables.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按已加载模型维护的 LRU 缓存，保存聊天模板渲染与分词的结果。命中时可跳过对相同消息列表的重复渲染 — 在长提示重复的场景下把热态 tokenize_ms 从约 240 毫秒降到接近 0。适用于所有引擎。0 表示禁用。"
          }
        }
      }
    },
    "Per-Request Defaults": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单次请求默认值"
