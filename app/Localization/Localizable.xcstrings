      }
    },
    "No model loaded yet — every section is shown so you can pre-tune. Once a model is active, sections that don't apply will hide automatically.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未加载模型 —— 这里显示了全部分区，方便你提前调好。模型激活之后，不适用的分区会自动隐藏。"
          }
