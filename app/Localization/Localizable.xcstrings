    },
    "This is one of the built-in agents. Duplicate it to make it yours.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是内置智能体之一。复制一份即可自由修改。"
          }
        }
      }
    },
    "This model is distilled for %lld steps; other values cost time without adding detail.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个模型是按 %1$lld 步蒸馏的；其他数值只会更慢，不会带来更多细节。"
          }
        }
      }
    },
    "This model writes its own soundtrack. Describe it in the prompt after \"overall_soundscape:\" (and \"non_diegetic_music:\" for score).": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个模型会自行创作配乐。请在提示词中的 \"overall_soundscape:\" 后面描述它（配乐则写在 \"non_diegetic_music:\" 后面）。"
          }
        }
      }
    },
    "This request needed %@ tokens, but the model's context window holds only %@.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次请求需要 %1$@ 个 token，而模型的上下文窗口只能容纳 %2$@ 个。"
