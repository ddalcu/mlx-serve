          }
        }
      }
    },
    "Output truncated — max tokens (%lld) reached. Try breaking the task into smaller steps, or raise “max tokens” in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输出被截断 — 已达到最大 token 数（%1$lld）。可以把任务拆成更小的步骤，或在设置中调高“最大 token 数”。"
          }
        }
      }
    },
    "PLD draft length": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
