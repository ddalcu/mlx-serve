            "value": "2GB"
          }
        }
      }
    },
    "3. Turn on “Enable Telegram bot”, then message your bot once to lock it to your chat.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 打开“启用 Telegram 机器人”，然后给你的机器人发一条消息，把它锁定到你的会话。"
          }
        }
      }
    },
