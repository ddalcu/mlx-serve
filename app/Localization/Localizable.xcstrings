    "Max seconds a single HTTP request is allowed to take. 0 = unlimited. Long agent loops may need 600+.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单个 HTTP 请求允许的最长秒数。0 表示不限制。长时间的智能体循环可能需要 600 以上。"
          }
        }
      }
    },
    "Max thinking tokens per request. -1 = unlimited. Only applies when thinking is enabled.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次请求的最大思考 token 数。-1 表示不限制。仅在启用思考时生效。"
          }
        }
      }
    },
    "Max tokens": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最大 token 数"
          }
        }
      }
    },
    "Max tokens to generate per chat turn. \"Auto\" pegs it to the remaining context window — the safe choice on a small-RAM / small-context machine. Per-message overrides win when set.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每轮对话最多生成的 token 数。“自动”会将其限制为剩余的上下文窗口 — 在内存小、上下文短的机器上更稳妥。单条消息的设置优先。"
          }
        }
      }
    },
    "Maximum RAM for the prefix cache. Accepts '2GB', '512MB', '0' (disable byte cap). Default 2GB.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前缀缓存可用的最大内存。可填 '2GB'、'512MB'、'0'（不限制字节数）。默认 2GB。"
          }
        }
      }
    },
    "Maximum draft tokens proposed per PLD step (default 5). Higher = bigger speedup when matches hit, more wasted work when they miss.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个 PLD 步骤最多提出的草稿 token 数（默认 5）。数值越大，命中时加速越明显，未命中时浪费的计算也越多。"
          }
        }
      }
    },
    "Maximum prompt + completion tokens. \"Auto\" fits the model to available memory when it loads — well under the model max — and holds that value until the server restarts. Higher values use more memory.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示加生成的最大 token 数。“自动”会在模型加载时根据可用内存来确定大小（明显低于模型上限），并在服务器重启前保持该值。数值越大占用内存越多。"
          }
        }
      }
    },
