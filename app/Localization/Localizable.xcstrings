          }
        }
      }
    },
    "Pages this answer drew on": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本回答参考的网页"
          }
        }
      }
    },
    "Pairs with the small assistant drafter for +27–40%% on code & agents (dense Gemma 4 only). On automatically: %@.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搭配小型助理草稿模型，在代码与智能体任务上提速 27–40%%（仅限稠密版 Gemma 4）。自动开启：%1$@。"
          }
        }
      }
    },
    "Paste raw PAT for headless auth — we base64-encode it": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴原始 PAT 用于无界面认证 — 我们会对它做 base64 编码"
