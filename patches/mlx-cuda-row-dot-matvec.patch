diff --git a/mlx/backend/cuda/gemms/row_dot.cuh b/mlx/backend/cuda/gemms/row_dot.cuh
new file mode 100644
index 0000000..d7dbfd6
--- /dev/null
+++ b/mlx/backend/cuda/gemms/row_dot.cuh
@@ -0,0 +1,237 @@
+// Copyright © 2026 Apple Inc.
+
+// Mat-vec over 16-bit, mxfp8, mxfp4 and nvfp4 weight rows with 16-byte loads.
+// A row is split over 8..256 threads, and up to ROWS rows of x share each load.
+
+#pragma once
+
+#include "mlx/backend/cuda/device.h"
+#include "mlx/backend/cuda/device/config.h"
+#include "mlx/backend/cuda/device/row_dot_ops.cuh"
+#include "mlx/backend/cuda/device/utils.cuh"
+
+#include <cuda_bf16.h>
+#include <cuda_fp16.h>
+#include <cuda_fp4.h>
+#include <cuda_fp8.h>
+
+#include <algorithm>
+#include <cstdint>
+
+namespace mlx::core::cu {
+
+constexpr int row_dot_threads = 256;
+
+// out[l, m, n] = x[lhs[l], m, :] . W[rhs[l], n, :]; lhs/rhs null = batch 0.
+// Grid: x = row groups, y = groups of ROWS x rows, z = batch.
+template <int FMT, int ROWS, typename T>
+__global__ void __launch_bounds__(row_dot_threads) row_dot_kernel(
+    const uint8_t* w,
+    const uint8_t* scales,
+    const T* x,
+    T* out,
+    int n,
+    int k,
+    int m,
+    int tpr,
+    const uint32_t* lhs_indices,
+    const uint32_t* rhs_indices,
+    int64_t w_batch_bytes,
+    int64_t s_batch_bytes) {
+  constexpr int bits = FMT == kRowDotDense ? 8 * sizeof(T)
+      : FMT == kRowDotMxfp8                ? 8
+                                           : 4;
+  constexpr int group = FMT == kRowDotNvfp4 ? 16 : 32;
+  const int64_t row_bytes = static_cast<int64_t>(k) * bits / 8;
+  const int chunks = static_cast<int>(row_bytes / 16);
+
+  const int rows_per_block = row_dot_threads / tpr;
+  const int r_local = threadIdx.x / tpr;
+  const int lane = threadIdx.x % tpr;
+  const int row = blockIdx.x * rows_per_block + r_local;
+  const bool active = row < n;
+
+  const int l = blockIdx.z;
+  const int64_t x_batch = lhs_indices ? lhs_indices[l] : 0;
+  const int64_t w_batch = rhs_indices ? rhs_indices[l] : 0;
+  const int m0 = blockIdx.y * ROWS;
+  const int rows = min(ROWS, m - m0);
+  x += (x_batch * m + m0) * static_cast<int64_t>(k);
+  out += (static_cast<int64_t>(l) * m + m0) * n;
+
+  float acc[ROWS];
+#pragma unroll
+  for (int r = 0; r < ROWS; ++r) {
+    acc[r] = 0.f;
+  }
+
+  if (active) {
+    const uint8_t* w_row = w + w_batch * w_batch_bytes + row * row_bytes;
+    const uint8_t* s_row = nullptr;
+    if constexpr (FMT != kRowDotDense) {
+      s_row = scales + w_batch * s_batch_bytes +
+          static_cast<int64_t>(row) * (k / group);
+    }
+    const uint4* wp = reinterpret_cast<const uint4*>(w_row);
+    row_dot_lane<FMT, ROWS>(wp, s_row, x, k, rows, chunks, lane, tpr, acc);
+  }
+
+  // Reduce in the warp, then across the warps of one row.
+  const int width = min(tpr, WARP_SIZE);
+#pragma unroll
+  for (int r = 0; r < ROWS; ++r) {
+    for (int off = width / 2; off > 0; off /= 2) {
+      acc[r] += __shfl_xor_sync(0xffffffff, acc[r], off);
+    }
+  }
+  if (tpr > WARP_SIZE) {
+    __shared__ float partial[ROWS][row_dot_threads / WARP_SIZE];
+    const int warp = threadIdx.x / WARP_SIZE;
+    if (threadIdx.x % WARP_SIZE == 0) {
+#pragma unroll
+      for (int r = 0; r < ROWS; ++r) {
+        partial[r][warp] = acc[r];
+      }
+    }
+    __syncthreads();
+    if (lane == 0 && active) {
+      const int warps = tpr / WARP_SIZE;
+#pragma unroll
+      for (int r = 0; r < ROWS; ++r) {
+        float s = 0.f;
+        for (int i = 0; i < warps; ++i) {
+          s += partial[r][warp + i];
+        }
+        if (r < rows) {
+          out[static_cast<int64_t>(r) * n + row] = static_cast<T>(s);
+        }
+      }
+    }
+  } else if (lane == 0 && active) {
+#pragma unroll
+    for (int r = 0; r < ROWS; ++r) {
+      if (r < rows) {
+        out[static_cast<int64_t>(r) * n + row] = static_cast<T>(acc[r]);
+      }
+    }
+  }
+}
+
+// Threads per row: fit short rows, then widen until the grid fills the GPU.
+// `rows` counts every output row of the launch, batches included.
+inline int row_dot_tpr(int chunks, int64_t rows, int num_sms) {
+  int tpr = 32;
+  while (tpr > 8 && 2 * tpr > chunks) {
+    tpr /= 2;
+  }
+  while (tpr < row_dot_threads && 2 * tpr <= chunks &&
+         rows * tpr / row_dot_threads < 4 * num_sms) {
+    tpr *= 2;
+  }
+  return tpr;
+}
+
+inline bool row_dot_aligned(const void* p) {
+  return reinterpret_cast<uintptr_t>(p) % 16 == 0;
+}
+
+inline int row_dot_num_sms(int device) {
+  static int sms = [device] {
+    int v = 0;
+    cudaDeviceGetAttribute(&v, cudaDevAttrMultiProcessorCount, device);
+    return v > 0 ? v : 1;
+  }();
+  return sms;
+}
+
+inline bool row_dot_integrated(int device) {
+  static bool integrated = [device] {
+    int v = 0;
+    cudaDeviceGetAttribute(&v, cudaDevAttrIntegrated, device);
+    return v != 0;
+  }();
+  return integrated;
+}
+
+// Needs 16-byte aligned rows of w and x: k * bits a multiple of 128, and
+// k / group even for nvfp4.
+template <typename T>
+void launch_row_dot(
+    CommandEncoder& encoder,
+    int fmt,
+    const void* w,
+    const void* scales,
+    const T* x,
+    T* out,
+    int n,
+    int k,
+    int m,
+    int batch,
+    const uint32_t* lhs_indices,
+    const uint32_t* rhs_indices,
+    int64_t w_batch_bytes,
+    int64_t s_batch_bytes) {
+  int bits = fmt == kRowDotDense ? 8 * sizeof(T) : fmt == kRowDotMxfp8 ? 8 : 4;
+  int chunks = static_cast<int>(static_cast<int64_t>(k) * bits / 128);
+  int rows_cap = m <= 1 ? 1 : m <= 2 ? 2 : m <= 4 ? 4 : 8;
+  int row_groups = (m + rows_cap - 1) / rows_cap;
+  int tpr = row_dot_tpr(
+      chunks,
+      static_cast<int64_t>(n) * batch * row_groups,
+      row_dot_num_sms(encoder.device().cuda_device()));
+  int rows_per_block = row_dot_threads / tpr;
+  dim3 grid(
+      (n + rows_per_block - 1) / rows_per_block, row_groups, batch);
+  auto wp = static_cast<const uint8_t*>(w);
+  auto sp = static_cast<const uint8_t*>(scales);
+  auto launch = [&]<int FMT>() {
+    auto go = [&]<int ROWS>() {
+      encoder.add_kernel_node(
+          row_dot_kernel<FMT, ROWS, T>,
+          grid,
+          dim3(row_dot_threads),
+          wp,
+          sp,
+          x,
+          out,
+          n,
+          k,
+          m,
+          tpr,
+          lhs_indices,
+          rhs_indices,
+          w_batch_bytes,
+          s_batch_bytes);
+    };
+    switch (rows_cap) {
+      case 1:
+        go.template operator()<1>();
+        break;
+      case 2:
+        go.template operator()<2>();
+        break;
+      case 4:
+        go.template operator()<4>();
+        break;
+      default:
+        go.template operator()<8>();
+        break;
+    }
+  };
+  switch (fmt) {
+    case kRowDotDense:
+      launch.template operator()<kRowDotDense>();
+      break;
+    case kRowDotMxfp8:
+      launch.template operator()<kRowDotMxfp8>();
+      break;
+    case kRowDotMxfp4:
+      launch.template operator()<kRowDotMxfp4>();
+      break;
+    default:
+      launch.template operator()<kRowDotNvfp4>();
+      break;
+  }
+}
+
+} // namespace mlx::core::cu
