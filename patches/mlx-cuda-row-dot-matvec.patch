new file mode 100644
index 0000000..afd818a
--- /dev/null
+++ b/mlx/backend/cuda/device/row_dot_ops.cuh
@@ -0,0 +1,205 @@
+// Copyright © 2025 Apple Inc.
+
+// row_dot's arithmetic, shared by its kernels and by JIT kernels that must
+// reproduce it bit for bit.
+
+#pragma once
+
+#include "mlx/backend/cuda/device/utils.cuh"
+
+#include <cuda_bf16.h>
+#include <cuda_fp16.h>
+#include <cuda_fp4.h>
+#include <cuda_fp8.h>
+
+namespace mlx::core::cu {
+
+enum RowDotFormat : int {
+  kRowDotDense = 0, // weights in the activation dtype
+  kRowDotMxfp8 = 1, // e4m3, one ue8m0 scale per 32
+  kRowDotMxfp4 = 2, // e2m1, one ue8m0 scale per 32
+  kRowDotNvfp4 = 3, // e2m1, one e4m3 scale per 16
+};
+
+__device__ __forceinline__ float2 row_dot_pair(uint32_t v, __nv_bfloat16) {
+  return __bfloat1622float2(*reinterpret_cast<__nv_bfloat162*>(&v));
+}
+__device__ __forceinline__ float2 row_dot_pair(uint32_t v, __half) {
+  return __half22float2(*reinterpret_cast<__half2*>(&v));
+}
+
+__device__ __forceinline__ float2 e4m3x2(uint32_t v16) {
+  __half2_raw h = __nv_cvt_fp8x2_to_halfraw2(
+      static_cast<__nv_fp8x2_storage_t>(v16 & 0xffff), __NV_E4M3);
+  return __half22float2(*reinterpret_cast<__half2*>(&h));
+}
+
+// 8 e2m1 codes (byte i holds codes 2i, 2i + 1 in its low, high nibble). The
+// fp4 cvt is one instruction only on arch-specific targets (sm_120a, sm_121a);
+// on plain sm_120 cuda_fp4.h emulates it, so there a byte-permute table builds
+// the same fp16 bits: magnitudes from the 8 values' high bytes, sign bits from
+// each code's top bit.
+__device__ __forceinline__ void e2m1x8(uint32_t v, float* out) {
+#pragma unroll
+  for (int i = 0; i < 4; ++i) {
+#if __CUDA_FP8_INTERNAL_CAN_RELY_ON_PTX_FOR_SHORTTYPESCVT__
+    __half2_raw h = __nv_cvt_fp4x2_to_halfraw2(
+        static_cast<__nv_fp4x2_storage_t>((v >> (8 * i)) & 0xff), __NV_E2M1);
+#else
+    uint32_t mag = __byte_perm(
+        0x3e3c3800, 0x46444240, i < 2 ? v & 0x7777 : (v >> 16) & 0x7777);
+    uint32_t m = __byte_perm(mag, 0, (i & 1) ? 0x3424 : 0x1404);
+    uint32_t s; // prmt selector bit 3 replicates the chosen byte's msb
+    asm("prmt.b32 %0, %1, %2, %3;"
+        : "=r"(s)
+        : "r"(v << 4), "r"(v), "r"(((8 | i) << 4) | ((12 + i) << 12)));
+    uint32_t h = m | (s & 0x80008000);
+#endif
+    float2 f = __half22float2(*reinterpret_cast<__half2*>(&h));
+    out[2 * i] = f.x;
+    out[2 * i + 1] = f.y;
+  }
+}
+
+__device__ __forceinline__ float ue8m0_scale(uint32_t s) {
+  return s == 0 ? __int_as_float(0x00400000) : __int_as_float(s << 23);
+}
+
+__device__ __forceinline__ float e4m3_scale(uint32_t s) {
+  __half_raw h = __nv_cvt_fp8_to_halfraw(
+      static_cast<__nv_fp8_storage_t>(s & 0xff), __NV_E4M3);
+  return __half2float(*reinterpret_cast<__half*>(&h));
+}
+
+// Dot of 8 * n_uint4 activations with weights already in float.
+template <typename T>
+__device__ __forceinline__ float
+dot_x(const T* x, const float* w, int n_uint4) {
+  float a = 0.f, b = 0.f;
+#pragma unroll 4
+  for (int i = 0; i < n_uint4; ++i) {
+    uint4 xv = reinterpret_cast<const uint4*>(x)[i];
+    float2 x0 = row_dot_pair(xv.x, T{});
+    float2 x1 = row_dot_pair(xv.y, T{});
+    float2 x2 = row_dot_pair(xv.z, T{});
+    float2 x3 = row_dot_pair(xv.w, T{});
+    const float* wi = w + 8 * i;
+    a = fmaf(x0.x, wi[0], a);
+    b = fmaf(x0.y, wi[1], b);
+    a = fmaf(x1.x, wi[2], a);
+    b = fmaf(x1.y, wi[3], b);
+    a = fmaf(x2.x, wi[4], a);
+    b = fmaf(x2.y, wi[5], b);
+    a = fmaf(x3.x, wi[6], a);
+    b = fmaf(x3.y, wi[7], b);
+  }
+  return a + b;
+}
+
+// Elements one 16-byte chunk of a weight row holds.
+template <int FMT, typename T>
+constexpr int row_dot_chunk_elems() {
+  return FMT == kRowDotDense ? 16 / sizeof(T) : FMT == kRowDotMxfp8 ? 16 : 32;
+}
+
+// Accumulates chunk `c` of one weight row against `rows` rows of x.
+template <int FMT, int ROWS, typename T>
+__device__ __forceinline__ void row_dot_chunk(
+    uint4 wv,
+    const uint8_t* s_row,
+    int c,
+    const T* x,
+    int64_t k,
+    int rows,
+    float* acc) {
+  constexpr int E = row_dot_chunk_elems<FMT, T>();
+  const T* xc = x + static_cast<int64_t>(c) * E;
+  uint32_t wu[4] = {wv.x, wv.y, wv.z, wv.w};
+  if constexpr (FMT == kRowDotDense) {
+    float w[8];
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+      float2 p = row_dot_pair(wu[i], T{});
+      w[2 * i] = p.x;
+      w[2 * i + 1] = p.y;
+    }
+#pragma unroll
+    for (int r = 0; r < ROWS; ++r) {
+      if (r < rows) {
+        acc[r] += dot_x(xc + r * k, w, 1);
+      }
+    }
+  } else if constexpr (FMT == kRowDotMxfp8) {
+    // 16 e4m3 = half a 32-wide scale group.
+    float scale = ue8m0_scale(s_row[c >> 1]);
+    float w[16];
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+      float2 lo = e4m3x2(wu[i]);
+      float2 hi = e4m3x2(wu[i] >> 16);
+      w[4 * i] = lo.x;
+      w[4 * i + 1] = lo.y;
+      w[4 * i + 2] = hi.x;
+      w[4 * i + 3] = hi.y;
+    }
+#pragma unroll
+    for (int r = 0; r < ROWS; ++r) {
+      if (r < rows) {
+        acc[r] += scale * dot_x(xc + r * k, w, 2);
+      }
+    }
+  } else {
+    // 32 e2m1: one ue8m0 group (mxfp4) or two e4m3 groups of 16 (nvfp4).
+    float w[32];
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+      e2m1x8(wu[i], w + 8 * i);
+    }
+    if constexpr (FMT == kRowDotMxfp4) {
+      float scale = ue8m0_scale(s_row[c]);
+#pragma unroll
+      for (int r = 0; r < ROWS; ++r) {
+        if (r < rows) {
+          acc[r] += scale * dot_x(xc + r * k, w, 4);
+        }
+      }
+    } else {
+      uint32_t s2 = *reinterpret_cast<const uint16_t*>(s_row + 2 * c);
+      float s0 = e4m3_scale(s2);
+      float s1 = e4m3_scale(s2 >> 8);
+#pragma unroll
+      for (int r = 0; r < ROWS; ++r) {
+        if (r < rows) {
+          const T* xr = xc + r * k;
+          acc[r] += s0 * dot_x(xr, w, 2) + s1 * dot_x(xr + 16, w + 16, 2);
+        }
+      }
+    }
+  }
+}
+
+// One thread's share of a weight row: chunks lane, lane + tpr, ..., two loads in flight.
+template <int FMT, int ROWS, typename T>
+__device__ __forceinline__ void row_dot_lane(
+    const uint4* wp,
+    const uint8_t* s_row,
+    const T* x,
+    int64_t k,
+    int rows,
+    int chunks,
+    int lane,
+    int tpr,
+    float* acc) {
+  int c = lane;
+  for (; c + tpr < chunks; c += 2 * tpr) {
+    uint4 a = wp[c];
+    uint4 b = wp[c + tpr];
+    row_dot_chunk<FMT, ROWS>(a, s_row, c, x, k, rows, acc);
+    row_dot_chunk<FMT, ROWS>(b, s_row, c + tpr, x, k, rows, acc);
+  }
+  if (c < chunks) {
+    row_dot_chunk<FMT, ROWS>(wp[c], s_row, c, x, k, rows, acc);
+  }
+}
+
+} // namespace mlx::core::cu
