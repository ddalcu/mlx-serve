+// A sorted fp gather of one x row per batch (rhs ascending): a block takes ROWS
+// consecutive batches and loads a weight row once per run on the same expert.
+// Each output is row_dot_kernel's at the same tpr.
+template <int FMT, int ROWS, typename T>
+__global__ void __launch_bounds__(row_dot_threads) row_dot_sorted_kernel(
+    const uint8_t* w,
+    const uint8_t* scales,
+    const T* x,
+    T* out,
+    int n,
+    int k,
+    int batch,
+    int tpr,
+    const uint32_t* lhs_indices,
+    const uint32_t* rhs_indices,
+    int64_t w_batch_bytes,
+    int64_t s_batch_bytes) {
+  constexpr int bits = FMT == kRowDotMxfp8 ? 8 : 4;
+  constexpr int group = FMT == kRowDotNvfp4 ? 16 : 32;
+  const int64_t row_bytes = static_cast<int64_t>(k) * bits / 8;
+  const int chunks = static_cast<int>(row_bytes / 16);
+
+  const int rows_per_block = row_dot_threads / tpr;
+  const int r_local = threadIdx.x / tpr;
+  const int lane = threadIdx.x % tpr;
+  const int row = blockIdx.x * rows_per_block + r_local;
+  const bool active = row < n;
+  const int l0 = blockIdx.z * ROWS;
+  const int rows = min(ROWS, batch - l0);
+  const int width = min(tpr, WARP_SIZE);
+  __shared__ float partial[ROWS][row_dot_threads / WARP_SIZE];
+
+  for (int r0 = 0; r0 < rows;) {
+    const uint32_t e = rhs_indices[l0 + r0];
+    int r1 = r0 + 1;
+    while (r1 < rows && rhs_indices[l0 + r1] == e) {
+      ++r1;
+    }
+    const int len = r1 - r0;
+    float acc[ROWS];
+#pragma unroll
+    for (int r = 0; r < ROWS; ++r) {
+      acc[r] = 0.f;
+    }
+    if (active) {
+      const T* xr[ROWS];
+#pragma unroll
+      for (int r = 0; r < ROWS; ++r) {
+        xr[r] = x +
+            static_cast<int64_t>(lhs_indices[l0 + r0 + min(r, len - 1)]) * k;
+      }
+      const uint8_t* s_row = scales + e * s_batch_bytes +
+          static_cast<int64_t>(row) * (k / group);
+      const uint4* wp = reinterpret_cast<const uint4*>(
+          w + e * w_batch_bytes + row * row_bytes);
+      // Up to four loads in flight, consumed in row_dot_kernel's chunk order.
+      for (int c = lane; c < chunks; c += 4 * tpr) {
+        uint4 v[4];
+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+          if (c + j * tpr < chunks) {
+            v[j] = wp[c + j * tpr];
+          }
+        }
+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+          if (c + j * tpr < chunks) {
+            row_dot_chunk_rows<FMT, ROWS>(v[j], s_row, c + j * tpr, xr, len, acc);
+          }
+        }
+      }
+    }
+#pragma unroll
+    for (int r = 0; r < ROWS; ++r) {
+      for (int off = width / 2; off > 0; off /= 2) {
+        acc[r] += __shfl_xor_sync(0xffffffff, acc[r], off);
+      }
+    }
+    if (tpr > WARP_SIZE) {
+      const int warp = threadIdx.x / WARP_SIZE;
+      if (threadIdx.x % WARP_SIZE == 0) {
+#pragma unroll
+        for (int r = 0; r < ROWS; ++r) {
+          partial[r][warp] = acc[r];
+        }
+      }
+      __syncthreads();
+      if (lane == 0 && active) {
+        const int warps = tpr / WARP_SIZE;
+#pragma unroll
+        for (int r = 0; r < ROWS; ++r) {
+          float s = 0.f;
+          for (int i = 0; i < warps; ++i) {
+            s += partial[r][warp + i];
+          }
+          if (r < len) {
+            out[static_cast<int64_t>(l0 + r0 + r) * n + row] = static_cast<T>(s);
+          }
+        }
+      }
+      __syncthreads();
+    } else if (lane == 0 && active) {
+#pragma unroll
+      for (int r = 0; r < ROWS; ++r) {
+        if (r < len) {
+          out[static_cast<int64_t>(l0 + r0 + r) * n + row] = static_cast<T>(acc[r]);
+        }
+      }
+    }
+    r0 = r1;
+  }
+}
