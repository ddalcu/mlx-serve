+// row_dot_chunk over rows of x at their own addresses, the same arithmetic per row.
+template <int FMT, int ROWS, typename T>
+__device__ __forceinline__ void row_dot_chunk_rows(
+    uint4 wv,
+    const uint8_t* s_row,
+    int c,
+    const T* const (&xr)[ROWS],
+    int rows,
+    float* acc) {
+  constexpr int E = row_dot_chunk_elems<FMT, T>();
+  uint32_t wu[4] = {wv.x, wv.y, wv.z, wv.w};
+  if constexpr (FMT == kRowDotMxfp8) {
+    float scale = ue8m0_scale(s_row[c >> 1]);
+    float w[16];
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+      float2 lo = e4m3x2(wu[i]);
+      float2 hi = e4m3x2(wu[i] >> 16);
+      w[4 * i] = lo.x;
+      w[4 * i + 1] = lo.y;
+      w[4 * i + 2] = hi.x;
+      w[4 * i + 3] = hi.y;
+    }
+#pragma unroll
+    for (int r = 0; r < ROWS; ++r) {
+      if (r < rows) {
+        acc[r] += scale * dot_x(xr[r] + static_cast<int64_t>(c) * E, w, 2);
+      }
+    }
+  } else {
+    float w[32];
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+      e2m1x8(wu[i], w + 8 * i);
+    }
+    if constexpr (FMT == kRowDotMxfp4) {
+      float scale = ue8m0_scale(s_row[c]);
+#pragma unroll
+      for (int r = 0; r < ROWS; ++r) {
+        if (r < rows) {
+          acc[r] += scale * dot_x(xr[r] + static_cast<int64_t>(c) * E, w, 4);
+        }
+      }
+    } else {
+      uint32_t s2 = *reinterpret_cast<const uint16_t*>(s_row + 2 * c);
+      float s0 = e4m3_scale(s2);
+      float s1 = e4m3_scale(s2 >> 8);
+#pragma unroll
+      for (int r = 0; r < ROWS; ++r) {
+        if (r < rows) {
+          const T* x = xr[r] + static_cast<int64_t>(c) * E;
+          acc[r] += s0 * dot_x(x, w, 2) + s1 * dot_x(x + 16, w + 16, 2);
+        }
+      }
+    }
+  }
+}
