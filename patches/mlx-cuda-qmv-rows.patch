+int qmv_max_rows(const cu::Device& device) {
+  // Read once: the variable and the device do not change in a process.
+  static const int cap = qmv_rows_cap(
+      device.compute_capability_major(),
+      device.compute_capability_minor(),
+      std::getenv("MLX_CUDA_QMV_MAX_ROWS"));
+  return cap;
+}
