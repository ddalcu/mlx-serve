+// Rows that share one weight read. A set MLX_CUDA_QMV_MAX_ROWS wins,
+// clamped to 1..8. Unset: 6 on GB10 (sm_121), 1 on every other chip.
+inline int qmv_rows_cap(int major, int minor, const char* env) {
+  if (env != nullptr && env[0] != '\0') {
+    return std::clamp(std::atoi(env), 1, 8);
+  }
+  if (major == 12 && minor == 1) {
+    return 6;
+  }
+  return 1;
+}
+
+// The cap of the first device asked, read once per process.
+int qmv_max_rows(const cu::Device& device);
+
