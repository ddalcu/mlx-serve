+// 2..8 rows of x against one weight matrix: each warp dequantizes its row of w
+// once and takes its dot product with every row of x.
+template <
+    int ROWS,
+    int rows_per_block,
+    int elems_per_thread,
+    int group_size,
+    bool has_bias,
+    bool has_residue_k,
+    typename T,
+    typename Q,
+    typename S>
+__global__ void qmv_rows_kernel(
+    const T* x,
+    const Q* w,
+    const S* scales,
+    const T* biases,
+    T* out,
+    int n,
+    int k) {
+  auto block = cg::this_thread_block();
+  auto warp = cg::tiled_partition<WARP_SIZE>(block);
+
+  int row = block.group_index().x * rows_per_block + warp.meta_group_rank();
+  if (row >= n) {
+    return;
+  }
+
+  constexpr int bits = cute::sizeof_bits_v<Q>;
+  auto w_step = [&](int idx) { return idx * cuda::std::min(8, bits) / 8; };
+  int groups_per_row = k / group_size;
+  w += static_cast<int64_t>(row) * w_step(k);
+  scales += static_cast<int64_t>(row) * groups_per_row;
+  if constexpr (has_bias) {
+    biases += static_cast<int64_t>(row) * groups_per_row;
+  }
+
+  float sums[ROWS] = {};
+
+  auto dequant_dot_tile = [&](int idx) {
+    constexpr int N = elems_per_thread;
+    S scale = scales[idx / group_size];
+    auto w_vec =
+        *(reinterpret_cast<const cutlass::Array<Q, N>*>(w + w_step(idx)));
+    cutlass::NumericArrayConverter<T, Q, N> converter_tq;
+    cutlass::Array<T, N> w_dq = converter_tq(w_vec);
+    if constexpr (has_bias) {
+      T bias = biases[idx / group_size];
+      if constexpr (cuda::std::is_same_v<T, float>) {
+#pragma unroll
+        for (int i = 0; i < N; ++i) {
+          w_dq[i] = w_dq[i] * T(scale) + bias;
+        }
+      } else {
+        w_dq = w_dq * T(scale) + bias;
+      }
+    } else {
+      w_dq = w_dq * T(scale);
+    }
+    float w_f[N];
+#pragma unroll
+    for (int i = 0; i < N; ++i) {
+      w_f[i] = static_cast<float>(w_dq[i]);
+    }
+#pragma unroll
+    for (int m = 0; m < ROWS; ++m) {
+      auto x_vec = *(reinterpret_cast<const cutlass::Array<T, N>*>(
+          x + static_cast<int64_t>(m) * k + idx));
+      float dot{0};
+#pragma unroll
+      for (int i = 0; i < N; ++i) {
+        dot = fmaf(static_cast<float>(x_vec[i]), w_f[i], dot);
+      }
+      sums[m] += dot;
+    }
+  };
+
+  constexpr int elems_per_warp = WARP_SIZE * elems_per_thread;
+  for (int r = 0; r < k / elems_per_warp; ++r) {
+    int idx = warp.thread_rank() * elems_per_thread + r * elems_per_warp;
+    dequant_dot_tile(idx);
+  }
+  if constexpr (has_residue_k) {
+    int rest = k % elems_per_warp;
+    int idx = warp.thread_rank() * elems_per_thread + k - rest;
+    if (idx < k) {
+      dequant_dot_tile(idx);
+    }
+  }
+
+#pragma unroll
+  for (int m = 0; m < ROWS; ++m) {
+    float sum = cg::reduce(warp, sums[m], cg::plus<float>{});
+    if (warp.thread_rank() == 0) {
+      out[static_cast<int64_t>(m) * n + row] = static_cast<T>(sum);
+    }
+  }
+}
