+TEST_CASE("test qmv rows cap") {
+  // GB10 (sm_121) shares one weight read across 6 rows. Other chips keep
+  // the tiled kernel. A set variable overrides either default.
+  CHECK(qmv_rows_cap(12, 1, nullptr) == 6);
+  CHECK(qmv_rows_cap(12, 1, "") == 6);
+  CHECK(qmv_rows_cap(12, 0, nullptr) == 1);
+  CHECK(qmv_rows_cap(8, 9, nullptr) == 1);
+  CHECK(qmv_rows_cap(12, 0, "6") == 6);
+  CHECK(qmv_rows_cap(12, 1, "1") == 1);
+  CHECK(qmv_rows_cap(12, 1, "9") == 8);
+  CHECK(qmv_rows_cap(12, 1, "0") == 1);
+}
+
+TEST_CASE("test quantized matmul rows kernel") {
+  // 2..8 rows, including a ragged K, and a 16-row matmul on the tiled kernel.
+  // Each row matches a dequantized reference. The rows kernel runs when the
+  // test binary starts with MLX_CUDA_QMV_MAX_ROWS=8 (the cap is read once).
+  for (int bits : {4, 8}) {
+    for (int k : {512, 1088}) {
+      auto w = random::normal({384, k}, bfloat16);
+      auto q = quantize(w, 64, bits);
+      auto w_dq = astype(dequantize(q[0], q[1], q[2], 64, bits), float32);
+      for (int m : {2, 3, 5, 6, 8, 16}) {
+        auto x = random::normal({m, k}, bfloat16);
+        auto out = quantized_matmul(x, q[0], q[1], q[2], true, 64, bits);
+        auto expected = matmul(astype(x, float32), transpose(w_dq));
+        CHECK(
+            allclose(astype(out, float32), expected, 2e-2, 2e-1).item<bool>());
+      }
+    }
+  }
