   std::tuple<int, int> get_max_ops_mb_per_buffer() const {
-    return std::make_tuple(max_ops_per_buffer_, max_mb_per_buffer_);
+    return std::make_tuple(
+        max_ops_per_buffer_.load(std::memory_order_relaxed),
