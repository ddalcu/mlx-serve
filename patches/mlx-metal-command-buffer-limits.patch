   }
+  // The command-buffer split: the operations and the MB of bound arrays a
+  // command buffer takes before it is committed (MLX_MAX_OPS_PER_BUFFER and
+  // MLX_MAX_MB_PER_BUFFER at the device's start). A value below 1 keeps the
+  // current one. Returns the previous pair; every encoder's next commit check
+  // (CommandEncoder::needs_commit) reads the new one.
+  std::tuple<int, int> set_max_ops_mb_per_buffer(int ops, int mb) {
+    int prev_ops = ops > 0
+        ? max_ops_per_buffer_.exchange(ops, std::memory_order_relaxed)
+        : max_ops_per_buffer_.load(std::memory_order_relaxed);
+    int prev_mb = mb > 0
+        ? max_mb_per_buffer_.exchange(mb, std::memory_order_relaxed)
+        : max_mb_per_buffer_.load(std::memory_order_relaxed);
+    return std::make_tuple(prev_ops, prev_mb);
+  }
 
