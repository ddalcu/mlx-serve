+#if defined(_WIN32)
+// mlx-serve: the CUDA and cuDNN DLLs come from the toolkit installed on the
+// machine (CUDA_PATH, CUDNN_PATH), never a build-machine path, so MLX and
+// llama.cpp load the same copies. The folder is the first that holds `dll`.
+std::string installed_dir(const char* var, const char* dll) {
+  const char* root = std::getenv(var);
+  if (!root) {
+    return {};
+  }
+  fs::path bin = fs::path(root) / "bin";
+  for (const auto& dir : {bin / "x64", bin}) {
+    if (fs::exists(dir / dll)) {
+      return dir.string();
+    }
+  }
+  std::error_code ec; // cuDNN's installer nests one folder per CUDA version
+  for (const auto& sub : fs::directory_iterator(bin, ec)) {
+    if (fs::exists(sub.path() / dll)) {
+      return sub.path().string();
+    }
+  }
+  return {};
+}
+#endif
+
 const char* cuda_bin_dir() {
-#if defined(MLX_CUDA_BIN_DIR)
+#if defined(_WIN32)
+  static const std::string dir = installed_dir("CUDA_PATH", "cudart64_13.dll");
+  return dir.empty() ? nullptr : dir.c_str();
+#elif defined(MLX_CUDA_BIN_DIR)
   static const std::string dir = resolve_bin_dir(MLX_CUDA_BIN_DIR);
   return dir.c_str();
 #else
