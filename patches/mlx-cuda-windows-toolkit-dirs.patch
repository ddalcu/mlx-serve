 // clang-format off
 #include <windows.h> // must be included first
 #include <delayimp.h>
+#include <string>
+#include <vector>
 // clang-format on
 
 namespace mlx::core::cu {
@@ -57,6 +59,14 @@ fs::path load_cudnn() {
   // Internally cuDNN loads some libs dynamically, add to search dirs.
   load_nvrtc();
   ::AddDllDirectory(cudnn_dir.c_str());
+  // mlx-serve: cuDNN loads its sub-libraries through the default DLL search,
+  // which AddDllDirectory does not reach, so its folder also goes first on PATH.
+  std::wstring path = cudnn_dir.wstring() + L";";
+  std::vector<wchar_t> old(32767);
+  DWORD n = ::GetEnvironmentVariableW(L"PATH", old.data(), (DWORD)old.size());
+  if (n < old.size()) {
+    ::SetEnvironmentVariableW(L"PATH", (path + std::wstring(old.data(), n)).c_str());
+  }
   ::AddDllDirectory(cublas_dir().c_str());
   return cudnn_dir;
 }
