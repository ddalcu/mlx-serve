+// The wide reserve (mlx-serve patch mlx-metal-wide-reserve.patch; off until a caller arms it, stock MLX until then).
+// A caller arms it with a byte floor and a list of buffer sizes: those buffers are allocated at once, written once
+// (their pages mapped before the first kernel writes them), and kept in the reserve. A request of at least the floor
+// that MLX's own cache cannot serve takes the smallest idle reserve buffer at least its size (any larger one: the
+// stock cache only hands out a buffer within two pages of the size); its free puts it back in the reserve. The
+// reserve is outside MLX's cache: clear_cache and the cache limit never release it. Disarming (floor 0) releases
+// the idle ones; one still in use leaves the reserve and is freed as any other buffer. Its bytes count as active
+// memory from the arming on, idle or in use (resident, as weights are), so a caller budgeting on MLX's active memory
+// sees them. State under the allocator's mutex; this file's own (the class layout stays the stock one).
+struct WideReserve {
+  size_t min_bytes{0}; // 0: disarmed
+  std::multimap<size_t, MTL::Buffer*> idle;
+  std::unordered_set<MTL::Buffer*> owned;
+  size_t idle_bytes{0};
+  size_t owned_bytes{0};
+  size_t hits{0};
+  size_t misses{0};
+  size_t miss_bytes{0};
+  // The reserve tests' planted control: every hit takes the largest buffer and leaves it idle, so live arrays share it.
+  bool plant_alias{false};
+};
+
+WideReserve& wide() {
+  static WideReserve* w = new WideReserve; // never destroyed, as the allocator
+  return *w;
+}
+
+// MLX_METAL_WIDE_LOG (diagnostic, read once): each armed request of at least the floor that misses both the cache
+// and the reserve prints its size.
+bool wide_log() {
+  static const bool on = std::getenv("MLX_METAL_WIDE_LOG") != nullptr;
+  return on;
+}
+
