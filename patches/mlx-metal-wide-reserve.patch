+// The wide reserve's C entry points (mlx-serve looks them up by name: a libmlx without the patch has none).
+// mlx_metal_wide_reserve: arm with a byte floor and the reserve's buffer sizes (floor 0 disarms and releases the
+// idle buffers); 0, or -1 when a size could not be allocated (the others kept).
+// mlx_metal_wide_reserve_stats: floor, buffers, bytes, idle bytes, hits, misses, missed bytes (the first n).
+extern "C" __attribute__((visibility("default"))) int
+mlx_metal_wide_reserve(size_t min_bytes, const size_t* sizes, size_t n) {
+  try {
+    return mlx::core::metal::allocator().wide_reserve(min_bytes, sizes, n);
+  } catch (...) {
+    return -1;
+  }
+}
+
+extern "C" __attribute__((visibility("default"))) void
+mlx_metal_wide_reserve_stats(size_t* out, size_t n) {
+  mlx::core::metal::allocator().wide_stats(out, n);
+}
+
+// The reserve's tests only: every hit shares one buffer (a planted aliasing bug their checks must catch).
+extern "C" __attribute__((visibility("default"))) void
+mlx_metal_wide_reserve_plant(int alias) {
+  mlx::core::metal::allocator().wide_plant(alias != 0);
+}
