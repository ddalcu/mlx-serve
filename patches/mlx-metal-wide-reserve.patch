+int MetalAllocator::wide_reserve(
+    size_t min_bytes,
+    const size_t* sizes,
+    size_t n) {
+  // Re-arming starts from an empty reserve: the idle buffers released, the ones in use left to the stock free.
+  auto& w = wide();
+  std::vector<MTL::Buffer*> drop;
+  {
+    std::unique_lock lk(mutex_);
+    std::unordered_set<MTL::Buffer*> seen; // the planted mode may list one twice
+    for (auto& [s, b] : w.idle) {
+      if (seen.insert(b).second) {
+        drop.push_back(b);
+      }
+    }
+    w.idle.clear();
+    w.owned.clear();
+    w.idle_bytes = 0;
+    w.owned_bytes = 0;
+    w.hits = 0;
+    w.misses = 0;
+    w.miss_bytes = 0;
+    w.min_bytes = 0;
+    w.plant_alias = false;
+    num_resources_ -= drop.size();
+    for (auto* b : drop) {
+      active_memory_ -= b->length();
+      if (!b->heap()) {
+        residency_sets_.erase(b);
+      }
+    }
+  }
+  {
+    auto pool = metal::new_scoped_memory_pool();
+    for (auto* b : drop) {
+      b->release();
+    }
+  }
+  if (min_bytes == 0) {
+    return 0;
+  }
+  int rc = 0;
+  for (size_t i = 0; i < n; i++) {
+    size_t size = sizes[i];
+    if (size == 0 || size > device_->maxBufferLength()) {
+      rc = -1;
+      continue;
+    }
+    size = vm_page_size * ((size + vm_page_size - 1) / vm_page_size);
+    MTL::Buffer* b = nullptr;
+    {
+      auto pool = metal::new_scoped_memory_pool();
+      b = device_->newBuffer(size, resource_options);
+    }
+    if (!b) {
+      rc = -1;
+      continue;
+    }
+    // Written once: its pages mapped now, not by the first kernel that writes it.
+    std::memset(b->contents(), 0, size);
+    std::unique_lock lk(mutex_);
+    num_resources_++;
+    residency_sets_.insert(b);
+    w.owned.insert(b);
+    w.idle.emplace(b->length(), b);
+    w.idle_bytes += b->length();
+    w.owned_bytes += b->length();
+    active_memory_ += b->length();
+    peak_memory_ = std::max(peak_memory_, active_memory_);
+  }
+  std::unique_lock lk(mutex_);
+  w.min_bytes = min_bytes;
+  return rc;
+}
+
+void MetalAllocator::wide_plant(bool alias) {
+  std::unique_lock lk(mutex_);
+  wide().plant_alias = alias;
+}
+
+void MetalAllocator::wide_stats(size_t* out, size_t n) {
+  auto& w = wide();
+  std::unique_lock lk(mutex_);
+  const size_t v[7] = {
+      w.min_bytes,
+      w.owned.size(),
+      w.owned_bytes,
+      w.idle_bytes,
+      w.hits,
+      w.misses,
+      w.miss_bytes};
+  for (size_t i = 0; i < n && i < 7; i++) {
+    out[i] = v[i];
+  }
+}
+
 size_t MetalAllocator::size(Buffer buffer) const {
   return static_cast<MTL::Buffer*>(buffer.ptr())->length();
 }
