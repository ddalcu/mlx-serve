 /*
+ * Apple's Virtualization.framework virtiofs device runs host-side as an
+ * unprivileged process, so an inode whose mode lacks the owner-read bit is
+ * a black hole for the guest: create fails EACCES (GNU tar's
+ * dangling-symlink placeholders and dpkg's .dpkg-new staging files, both
+ * mode 000, hit this), and an existing one can't be stat'ed, opened,
+ * chmod'ed back or even unlinked — only readdir still shows the name.
+ * Guarantee owner-read on every mode we send (creates AND chmod);
+ * directories get owner-rwx, since the host also needs write+search on a
+ * directory to create or look up children in it.  Gated per-connection
+ * (clamp_owner_read), set only by virtiofs.
+ */
+static umode_t fuse_clamp_create_mode(struct fuse_conn *fc, umode_t mode,
+				      bool isdir)
+{
+	if (!fc->clamp_owner_read || (mode & S_IRUSR))
+		return mode;
+	if (!isdir && !S_ISREG(mode))
+		return mode; /* symlinks / device nodes / fifos: leave untouched */
+	return mode | (isdir ? S_IRWXU : S_IRUSR);
+}
+
